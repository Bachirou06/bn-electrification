# ── Travel Time — MAP Accessibility Raster ───────────────────────────────────
# Source: Weiss et al. 2020, Oxford Malaria Atlas Project
# File:   data/raw/rasters/accessibility_cities_benin.tif
# Values: minutes of motorized travel time to nearest city >=50,000 pop
# Expected range: 0 – 600 min  (QGIS screenshot confirmed 0–587)

ACCESS_RASTER = FILES['access']

if ACCESS_RASTER.exists():

    # ── Step 1: raster diagnostics ────────────────────────────────────────
    print('=== ACCESSIBILITY RASTER DIAGNOSTICS ===')
    with rasterio.open(ACCESS_RASTER) as src:
        band   = src.read(1).astype(float)
        nd     = src.nodata
        r_crs  = src.crs
        r_tf   = src.transform
        print(f'  File    : {ACCESS_RASTER.name}')
        print(f'  Size    : {src.width} × {src.height} px')
        print(f'  CRS     : {r_crs}')
        print(f'  NoData  : {nd}')
        # Mask nodata — MAP raster commonly uses -9999, 3.4e+38, or -32768
        mask = np.ones(band.shape, dtype=bool)
        if nd is not None:
            mask &= (band != nd)
        mask &= np.isfinite(band)
        mask &= (band >= 0)
        valid_px = band[mask]
        print(f'  Valid px: {valid_px.size:,} / {band.size:,} '
              f'({valid_px.size/band.size*100:.1f}%)')
        print(f'  Range   : {valid_px.min():.1f} – {valid_px.max():.1f} min')
        print(f'  Mean    : {valid_px.mean():.1f} min')

    # ── Step 2: extract with explicit nodata list ─────────────────────────
    # MAP raster nodata candidates: -9999, -32768, 3.4028235e+38, 65535
    NODATA_CANDIDATES = [-9999, -32768, 65535, 3.4028235e+38]

    with rasterio.open(ACCESS_RASTER) as src:
        raster_crs = src.crs
        nd_val     = src.nodata

        # Reproject settlement points to raster CRS if needed
        if raster_crs and raster_crs.to_epsg() != 4326:
            pts    = gpd.GeoDataFrame(
                geometry=gpd.points_from_xy(gdf['lon'], gdf['lat']),
                crs='EPSG:4326'
            ).to_crs(raster_crs)
            coords = list(zip(pts.geometry.x, pts.geometry.y))
        else:
            coords = list(zip(gdf['lon'], gdf['lat']))

        raw_vals = [v[0] for v in src.sample(coords)]

    s = pd.Series(raw_vals, index=gdf.index, dtype=float)

    # Mask all known nodata values
    if nd_val is not None:
        s = s.replace(nd_val, np.nan)
    for nd_c in NODATA_CANDIDATES:
        s = s.replace(nd_c, np.nan)
    s = s.where(np.isfinite(s), np.nan)   # remove inf / nan
    s = s.where(s >= 0, np.nan)            # remove negatives
    s = s.where(s <= 1440, np.nan)         # cap at 24 hours (1440 min) — sanity check

    n_valid = s.notna().sum()
    n_total = len(s)
    print(f'\n  Extraction result:')
    print(f'  Valid values : {n_valid:,} / {n_total:,} '
          f'({n_valid/n_total*100:.1f}%)')
    print(f'  Unique values: {s.nunique():,}  '
          f'← if <=3, raster CRS or extent is wrong')

    if s.nunique() <= 3:
        print()
        print('  ⚠ WARNING: Only', s.nunique(), 'unique values extracted!')
        print('  Possible causes:')
