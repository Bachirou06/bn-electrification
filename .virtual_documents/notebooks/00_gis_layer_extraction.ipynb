        print(f'  {col:<26}: {n_valid:,}/{len(gdf):,} valid')
    else:
        print(f'  {col:<26}: NOT IN DATAFRAME')

# ── Save GeoJSON with timestamp ───────────────────────────────────────────────
from datetime import datetime
timestamp = datetime.now().strftime('%Y%m%d_%H%M')
OUT = OUTPUT_PATH.parent / f'settlements_gis_enriched_{timestamp}.geojson'

gdf.to_file(OUT, driver='GeoJSON')
print(f'\nSaved → {OUT.relative_to(BASE_DIR)}')
print(f'Done. {len(gdf):,} settlements enriched with {len(all_new_cols)} resource layers.')










